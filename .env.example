# Core
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=smartappointments
DB_USER=smartuser
DB_PASSWORD=smartpass
DB_HOST=mysql
DB_PORT=3306
DB_ROOT_PASSWORD=rootpass

# Business settings
BUSINESS_TZ=Asia/Kolkata
BUFFER_MINUTES=10
MIN_LEAD_MINUTES=30
BOOKING_WINDOW_DAYS=30
STAFF_CAN_EDIT_OWN_HOURS=False

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@smartappointment.local

# CORS / app URLs
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_BUSINESS_NAME=Smart Appointment Scheduler
COOKIE_SECURE=False

# Optional
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
